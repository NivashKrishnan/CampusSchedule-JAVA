<%@ page pageEncoding="UTF-8" %>
<%-- Included within app.jsp: shared escaping, identity and page variables. --%>
<%if("dashboard".equals(pageName)){%>
<section class="hero"><div><span class="eyebrow"><%=h(role)%> WORKSPACE</span><h2>Your week, in one place.</h2><p>View the schedules published for <%=role.equals("teacher")?"your teaching assignments":"your class"%>. Download or print a copy whenever you need it.</p><a class="button light" href="app?page=saved">Open my timetables →</a></div><div class="hero-calendar"><strong><%=rows(request,"saved").size()%></strong><p>Published timetables</p></div></section>
<section class="panel" style="margin-top:24px"><h2>Welcome, <%=h(identity.get("username"))%></h2><p>Your account is linked to <%=role.equals("teacher")?"one teacher":"one class"%>. Only matching published schedules are available here.</p><p class="muted">If a schedule is missing, ask your administrator to check the account assignment and publish the timetable.</p><a href="app?page=account">Manage my password →</a></section>
<%}else if("saved".equals(pageName)){%>
<section class="panel"><div class="panel-heading"><div><span class="eyebrow">SCHEDULE LIBRARY</span><h2><%=isAdmin?"Saved timetables":"My published timetables"%></h2><p class="muted"><%=isAdmin?"Review a draft, make changes, then publish it for teachers and students.":"Only schedules published for your account appear here."%></p></div><input class="search" id="search" placeholder="Search timetables" aria-label="Search timetables"></div><div class="table-wrap"><table id="records"><thead><tr><th>Name</th><th>Status</th><th>Created</th><th>Teaching week</th><th>Open</th></tr></thead><tbody>
<%for(Map<String,String>x:rows(request,"saved")){%><tr><td><strong><%=h(x.get("name"))%></strong></td><td><span class="badge <%=x.get("status")%>"><%=h(x.get("status"))%></span></td><td><%=h(x.get("created_at"))%></td><td><%=x.get("days")%> days × <%=x.get("periods")%> periods</td><td><a href="app?page=timetable&id=<%=x.get("id")%>">Open timetable →</a></td></tr><%}%>
</tbody></table></div><%if(rows(request,"saved").isEmpty()){%><div class="empty">No <%=isAdmin?"saved":"published"%> timetables yet.</div><%}%><p class="empty search-empty" hidden>No matching records.</p></section>
<%}else if("timetable".equals(pageName)&&request.getAttribute("run")!=null){Map<String,String> run=(Map<String,String>)request.getAttribute("run");List<Map<String,String>> entries=rows(request,"entries");String view=Portal.text(request,"view");if(!Arrays.asList("class","teacher","room").contains(view))view="class";if(!isAdmin)view=role.equals("teacher")?"teacher":"class";String idKey=view.equals("teacher")?"faculty_id":view.equals("room")?"room_id":"class_id";String nameKey=view.equals("teacher")?"faculty_name":view.equals("room")?"room_name":"class_name";Map<String,String> groups=new LinkedHashMap<String,String>();for(Map<String,String> e:entries)groups.put(e.get(idKey),e.get(nameKey));String filter=Portal.text(request,"group");%>
<div class="panel-heading result-heading"><div><span class="eyebrow"><%=h(settings.get("institution"))%> · SAVED #<%=run.get("id")%></span><h2><%=h(run.get("name"))%></h2><p class="muted"><span class="badge <%=run.get("status")%>"><%=h(run.get("status"))%></span> · <%=entries.size()%> accessible lessons · <%=h(run.get("created_at"))%></p></div><div class="actions no-print"><a class="button secondary" href="app?page=export&id=<%=run.get("id")%>">Download CSV</a><button class="primary" onclick="window.print()">Print / Save PDF</button></div></div>
<form method="get" action="app" class="panel filters no-print"><input type="hidden" name="page" value="timetable"><input type="hidden" name="id" value="<%=run.get("id")%>"><label>View by<select name="view" <%=isAdmin?"":"disabled"%> onchange="this.form.querySelector('[name=group]').value='';this.form.submit()"><%for(String v:new String[]{"class","teacher","room"}){%><option value="<%=v%>" <%=view.equals(v)?"selected":""%>><%=v.equals("class")?"Class":v.equals("teacher")?"Teacher":"Room"%></option><%}%></select></label><label>Show<select name="group"><option value="">All <%=view%> schedules</option><%for(Map.Entry<String,String>g:groups.entrySet()){%><option value="<%=g.getKey()%>" <%=g.getKey().equals(filter)?"selected":""%>><%=h(g.getValue())%></option><%}%></select></label><button class="primary">Apply view</button><a class="button secondary" href="app?page=saved">Back to library</a></form>
<%if(isAdmin){%><details class="panel no-print manage"><summary>Manage this timetable <span class="muted">Rename, duplicate, publish or remove a draft</span></summary><div class="form-grid"><form method="post" action="app"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=run.get("id")%>"><input type="hidden" name="action" value="renameRun"><label>Timetable name<input name="name" value="<%=h(run.get("name"))%>" maxlength="80" required></label><button class="secondary">Rename timetable</button></form><div><p class="muted">Publishing shares this schedule with linked teacher and student accounts. Unpublish before editing or deleting it.</p><div class="actions wrap"><%for(String a:new String[]{"cloneRun","publishRun","deleteRun"}){if(a.equals("deleteRun")&&run.get("status").equals("published"))continue;%><form method="post" action="app" <%=a.equals("deleteRun")?"onsubmit=\"return confirm('Permanently delete this draft and all its lesson entries?')\"":""%>><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=run.get("id")%>"><input type="hidden" name="action" value="<%=a%>"><button class="<%=a.equals("deleteRun")?"danger":"secondary"%>"><%=a.equals("cloneRun")?"Duplicate as draft":a.equals("publishRun")?(run.get("status").equals("published")?"Unpublish":"Publish timetable"):"Delete draft"%></button></form><%}%></div></div></div></details><%}%>
<%int visibleGroups=0;for(Map.Entry<String,String>group:groups.entrySet()){if(!filter.isEmpty()&&!filter.equals(group.getKey()))continue;visibleGroups++;Map<String,Map<String,String>> grid=new HashMap<String,Map<String,String>>();for(Map<String,String>e:entries)if(e.get(idKey).equals(group.getKey()))grid.put(e.get("day_no")+":"+e.get("period_no"),e);%>
<section class="panel timetable-panel"><div class="panel-heading"><h2><%=h(group.getValue())%></h2><span class="pill"><%=view%> schedule · <%=grid.size()%> periods</span></div><div class="table-wrap"><table class="timetable"><thead><tr><th>Day</th><%for(int p=1;p<=Integer.parseInt(run.get("periods"));p++){%><th>Period <%=p%><small class="period-time"><%=Portal.times(run,p)%></small></th><%}%></tr></thead><tbody><%for(int d=1;d<=Integer.parseInt(run.get("days"));d++){%><tr><th><%=dayNames[d-1]%></th><%for(int p=1;p<=Integer.parseInt(run.get("periods"));p++){Map<String,String>e=grid.get(d+":"+p);%><td><%if(e==null){%><span class="free">Free</span><%}else{%><div class="lesson"><strong><%=h(e.get("subject_name"))%></strong><%if(!view.equals("class")){%><span><%=h(e.get("class_name"))%></span><%}if(!view.equals("teacher")){%><span><%=h(e.get("faculty_name"))%></span><%}if(!view.equals("room")){%><small><%=h(e.get("room_name"))%></small><%}%></div><%}%></td><%}%></tr><%}%></tbody></table></div></section><%}if(visibleGroups==0){%><div class="panel empty">No schedules match this filter.</div><%}%>
<%if(isAdmin&&"draft".equals(run.get("status"))){%><details class="panel no-print"><summary>Reschedule a lesson <span class="muted">Change its day, period or room with conflict checks</span></summary><p class="muted">Uses the current teacher availability and room rules. If source records were removed or reassigned, generate a new timetable. For a swap, first move one lesson to a free slot.</p><form method="post" action="app"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=run.get("id")%>"><input type="hidden" name="action" value="moveLesson"><label>Lesson<select name="entry_id" required><%for(Map<String,String>e:entries){%><option value="<%=e.get("id")%>"><%=h(e.get("class_name"))%> · <%=h(e.get("subject_name"))%> · <%=dayNames[Integer.parseInt(e.get("day_no"))-1]%> P<%=e.get("period_no")%> · <%=h(e.get("room_name"))%></option><%}%></select></label><div class="form-grid"><label>New day<select name="day_no"><%for(int d=1;d<=Integer.parseInt(run.get("days"));d++){%><option value="<%=d%>"><%=dayNames[d-1]%></option><%}%></select></label><label>New period<select name="period_no"><%for(int p=1;p<=Integer.parseInt(run.get("periods"));p++){%><option value="<%=p%>">Period <%=p%></option><%}%></select></label><label>New room<select name="room_id"><%for(Map<String,String>room:rows(request,"classrooms")){%><option value="<%=room.get("id")%>"><%=h(room.get("name"))%> · <%=room.get("capacity")%> seats · <%=h(room.get("type"))%></option><%}%></select></label></div><button class="primary">Check & move lesson</button></form></details><%}%>
<%}else if("reports".equals(pageName)){%>
<div class="panel-heading"><div><span class="eyebrow">WORKLOAD & ALLOCATION</span><h2>Reports from your saved records</h2></div><button class="secondary no-print" onclick="window.print()">Print reports</button></div><section class="panel"><h2>Teacher workload</h2><p class="muted">Allocated periods are calculated from subject requirements. These are teaching periods, not clock hours.</p><div class="table-wrap"><table><thead><tr><th>Teacher</th><th>Subjects</th><th>Allocated periods</th><th>Weekly limit</th><th>Load</th></tr></thead><tbody><%for(Map<String,String>w:rows(request,"workload")){int used=Integer.parseInt(w.get("allocated")),limit=Integer.parseInt(w.get("max_hours"));%><tr><td><%=h(w.get("name"))%></td><td><%=w.get("subject_count")%></td><td><%=used%></td><td><%=limit%></td><td><div class="meter"><span style="width:<%=Math.min(100,used*100/limit)%>%"></span></div><span class="<%=used>limit?"warning-text":"muted"%>"><%=used>limit?"Over limit by "+(used-limit):limit-used+" periods available"%></span></td></tr><%}%></tbody></table></div></section>
<section class="panel"><h2>Class subject allocation</h2><table><thead><tr><th>Class</th><th>Subjects</th><th>Required periods</th><th>Default week capacity</th><th>Readiness</th></tr></thead><tbody><%for(Map<String,String>w:rows(request,"classload")){int used=Integer.parseInt(w.get("allocated")),capacity=Integer.parseInt(settings.get("days"))*Integer.parseInt(settings.get("periods"));%><tr><td><%=h(w.get("name"))%></td><td><%=w.get("subject_count")%></td><td><%=used%></td><td><%=capacity%></td><td><%=used==0?"No subjects assigned":used>capacity?"Exceeds default week":"Within weekly capacity"%></td></tr><%}%></tbody></table></section>
<section class="panel"><h2>Room usage in a saved timetable</h2><form class="filters no-print" method="get" action="app"><input type="hidden" name="page" value="reports"><label>Timetable<select name="id" required><option value="">Select timetable...</option><%for(Map<String,String>x:rows(request,"saved")){%><option value="<%=x.get("id")%>" <%=x.get("id").equals(Portal.text(request,"id"))?"selected":""%>><%=h(x.get("name"))%> (#<%=x.get("id")%>)</option><%}%></select></label><button class="primary">Show room usage</button></form><%Map<String,String> rr=(Map<String,String>)request.getAttribute("reportRun");if(rr!=null){%><p><strong><%=h(rr.get("name"))%></strong></p><table><thead><tr><th>Room</th><th>Occupied periods</th><th>Week capacity</th><th>Utilisation</th></tr></thead><tbody><%int cap=Integer.parseInt(rr.get("days"))*Integer.parseInt(rr.get("periods"));for(Map<String,String>w:rows(request,"roomload")){%><tr><td><%=h(w.get("room_name"))%></td><td><%=w.get("allocated")%></td><td><%=cap%></td><td><%=Math.round(100.0*Integer.parseInt(w.get("allocated"))/cap)%>%</td></tr><%}%></tbody></table><p class="muted">Rooms with no lessons in this saved timetable are omitted. Usage is based on its stored lesson entries.</p><%}%></section>
<%}else if("availability".equals(pageName)){String teacher=Portal.text(request,"teacher");if(teacher.isEmpty()&&!rows(request,"faculty").isEmpty())teacher=rows(request,"faculty").get(0).get("id");Map<String,String>selected=null;for(Map<String,String>f:rows(request,"faculty"))if(f.get("id").equals(teacher))selected=f;%>
<section class="panel"><h2>Teacher availability</h2><p class="muted">Select periods when the teacher cannot teach. Updates apply to future generation and lesson moves; existing saved schedules remain unchanged.</p><form method="get" action="app" class="filters"><input type="hidden" name="page" value="availability"><label>Teacher<select name="teacher" onchange="this.form.submit()"><%for(Map<String,String>f:rows(request,"faculty")){%><option value="<%=f.get("id")%>" <%=f.get("id").equals(teacher)?"selected":""%>><%=h(f.get("name"))%></option><%}%></select></label><button class="secondary">Load availability</button></form>
<%if(selected!=null){Set<String>blocked=new HashSet<String>(Arrays.asList(selected.get("unavailable").split(",")));%><form method="post" action="app"><input type="hidden" name="action" value="availability"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="faculty_id" value="<%=selected.get("id")%>"><h3><%=h(selected.get("name"))%></h3><div class="table-wrap"><table class="availability"><thead><tr><th>Day</th><%for(int p=1;p<=8;p++){%><th>P<%=p%></th><%}%></tr></thead><tbody><%for(int d=1;d<=6;d++){%><tr><th><%=dayNames[d-1]%></th><%for(int p=1;p<=8;p++){String slot=d+":"+p;%><td><label><input type="checkbox" name="blocked" value="<%=slot%>" <%=blocked.contains(slot)?"checked":""%> aria-label="Unavailable <%=dayNames[d-1]%> period <%=p%>"><span>Unavailable</span></label></td><%}%></tr><%}%></tbody></table></div><div class="actions"><button class="primary">Save availability</button><button type="button" class="secondary" onclick="this.form.querySelectorAll('[name=blocked]').forEach(c=>c.checked=false)">Clear selection</button></div></form><%}else{%><p class="empty">Add a teacher to set availability.</p><%}%></section>
<%}else if("settings".equals(pageName)){%>
<section class="panel"><span class="eyebrow">WORKING DAYS & HOURS</span><h2>Academic and timetable settings</h2><p class="muted">Defaults are used for new timetables. Saved schedules retain their original period timings.</p><form method="post" action="app"><input type="hidden" name="action" value="settings"><input type="hidden" name="csrf" value="<%=csrf%>"><div class="form-grid"><label>Institution<input name="institution" value="<%=h(settings.get("institution"))%>" maxlength="80" required></label><label>Academic year<input name="academic_year" value="<%=h(settings.get("academic_year"))%>" maxlength="30" required></label></div><div class="form-grid"><%for(String key:new String[]{"days","periods","period_minutes","break_after","break_minutes"}){int max=key.equals("days")?6:key.equals("periods")||key.equals("break_after")?8:120;int min=key.startsWith("break")?0:key.equals("period_minutes")?20:1;%><label><%=key.equals("days")?"Working days":key.equals("periods")?"Teaching periods per day":key.equals("period_minutes")?"Minutes per period":key.equals("break_after")?"Break after period (0 = none)":"Break duration in minutes"%><input type="number" name="<%=key%>" min="<%=min%>" max="<%=max%>" value="<%=settings.get(key)%>" required></label><%}%><label>Day starts at<input type="time" name="start_time" value="<%=h(settings.get("start_time"))%>" required></label></div><p class="muted">Working days begin on Monday. One break can be inserted between teaching periods. Lab lessons currently occupy individual periods.</p><button class="primary">Save settings</button></form></section>
<%}else if("users".equals(pageName)){%>
<section class="panel"><span class="eyebrow">ACCESS MANAGEMENT</span><h2>Create a login account</h2><p class="muted">Teachers see only their own published lessons. Students see only their linked class. Administrators can manage the entire project.</p><form method="post" action="app"><input type="hidden" name="action" value="createUser"><input type="hidden" name="csrf" value="<%=csrf%>"><div class="form-grid"><label>Username<input name="username" pattern="[A-Za-z0-9_.-]{3,40}" required autocomplete="off"></label><label>Initial password<input type="password" name="password" minlength="8" maxlength="100" required autocomplete="new-password"></label><label>Role<select name="role" id="role-choice"><option value="teacher">Teacher</option><option value="student">Student</option><option value="admin">Administrator</option></select></label><label id="teacher-link">Linked teacher<select name="faculty_id"><option value="">Select teacher...</option><%for(Map<String,String>f:rows(request,"faculty")){%><option value="<%=f.get("id")%>"><%=h(f.get("name"))%></option><%}%></select></label><label id="class-link">Linked class<select name="class_id"><option value="">Select class...</option><%for(Map<String,String>f:rows(request,"classes")){%><option value="<%=f.get("id")%>"><%=h(f.get("name"))%></option><%}%></select></label></div><button class="primary">Create account</button></form></section>
<section class="panel"><p class="muted">Before approving a registration, verify the person and their linked teacher record or class. Only published timetables are visible to approved users.</p><div class="panel-heading"><h2>Login accounts and registration requests</h2><input class="search" id="search" aria-label="Search accounts" placeholder="Search accounts"></div><div class="table-wrap"><table id="records"><thead><tr><th>Username</th><th>Role</th><th>Linked record</th><th>Status</th><th>Manage</th></tr></thead><tbody><%for(Map<String,String>u:rows(request,"users")){%><tr><td><%=h(u.get("username"))%></td><td><%=h(u.get("role"))%></td><td><%=h(u.get("role").equals("teacher")?lookup(request,"faculty",u.get("faculty_id")):u.get("role").equals("student")?lookup(request,"classes",u.get("class_id")):"All records")%></td><td><%=u.get("active").equals("1")?"Active":"Awaiting approval / disabled"%></td><td><%if(!u.get("role").equals("admin")){%><form method="post" action="app"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="userStatus"><input type="hidden" name="id" value="<%=u.get("id")%>"><button class="secondary"><%=u.get("active").equals("1")?"Disable":"Approve / enable"%></button></form><details><summary>Reset password</summary><form method="post" action="app"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="resetPassword"><input type="hidden" name="id" value="<%=u.get("id")%>"><label>New password for <%=h(u.get("username"))%><input type="password" name="password" minlength="8" maxlength="100" required autocomplete="new-password"></label><button class="secondary">Reset password</button></form></details><%}else{%><span class="muted">Self-service password change</span><%}%></td></tr><%}%></tbody></table></div></section>
<%}else if("account".equals(pageName)){%><section class="panel guide"><h2>My account</h2><p><strong><%=h(identity.get("username"))%></strong> · <%=h(role)%></p><form method="post" action="app"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="account"><label>Current password<input type="password" name="current_password" autocomplete="current-password" required></label><label>New password<input type="password" name="new_password" minlength="8" maxlength="100" autocomplete="new-password" required></label><label>Confirm new password<input type="password" name="confirm_password" minlength="8" maxlength="100" autocomplete="new-password" required></label><button class="primary">Change password</button></form></section>
<%}else if("activity".equals(pageName)){%><section class="panel"><div class="panel-heading"><h2>Recent activity</h2><input class="search" id="search" aria-label="Search activity" placeholder="Search activity"></div><p class="muted">The latest 40 recorded changes. Password values are never written here.</p><div class="table-wrap"><table id="records"><thead><tr><th>Time</th><th>Account</th><th>Action</th><th>Detail</th></tr></thead><tbody><%for(Map<String,String>a:rows(request,"activity")){%><tr><td><%=h(a.get("created_at"))%></td><td><%=h(a.get("username"))%></td><td><%=h(a.get("action"))%></td><td><%=h(a.get("detail"))%></td></tr><%}%></tbody></table></div></section><%}%>
