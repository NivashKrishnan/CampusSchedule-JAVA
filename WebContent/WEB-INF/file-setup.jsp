<%@ page contentType="text/html;charset=UTF-8" import="app.Security" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Owner setup | CampusSchedule</title><link rel="stylesheet" href="assets/app.css"><link rel="stylesheet" href="assets/login.css"></head><body class="login"><main class="login-card">
<div class="login-brand"><div class="brand-mark">CS</div><div><h1>CampusSchedule</h1><p>Set up your shared workspace</p></div></div><h2>Create the owner account</h2><p>The owner creates academic records and approves teacher and student accounts. The setup key is configured privately by the website owner.</p>
<%if(session.getAttribute("message")!=null){%><p role="alert"><%=Security.html(session.getAttribute("message"))%></p><%session.removeAttribute("message");}%>
<%if(!Boolean.TRUE.equals(request.getAttribute("setupReady"))){%><div class="notice error" role="alert">Owner setup is not enabled on this deployment. Save <code>TIMETABLE_SETUP_KEY</code> with at least 32 characters for this project's Production environment, then redeploy and open this page again.</div><%}else{%>
<form method="post" action="app"><input type="hidden" name="action" value="setup"><input type="hidden" name="csrf" value="<%=Security.html(session.getAttribute("csrf"))%>"><label>Owner setup key<input type="password" name="setup_key" autocomplete="off" required></label><label>Admin username<input name="username" pattern="[A-Za-z0-9_.-]{3,40}" autocomplete="username" required></label><label>Password<input type="password" name="password" minlength="12" maxlength="100" autocomplete="new-password" required></label><label>Confirm password<input type="password" name="confirm_password" minlength="12" maxlength="100" autocomplete="new-password" required></label><button class="primary">Create owner account</button></form><%}%><p class="muted">Records will be stored in private cloud files and shared across your devices. This setup closes permanently after the first account is created.</p></main></body></html>
