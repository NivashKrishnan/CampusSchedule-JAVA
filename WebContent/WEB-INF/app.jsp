<%@ page contentType="text/html;charset=UTF-8" import="java.util.*,app.*" %>
<%!
String h(Object s){return Security.html(s);}
List<Map<String,String>> rows(javax.servlet.http.HttpServletRequest r,String key){Object v=r.getAttribute(key);return v==null?new ArrayList<Map<String,String>>():(List<Map<String,String>>)v;}
String lookup(javax.servlet.http.HttpServletRequest r,String table,String id){for(Map<String,String>x:rows(r,table))if(x.get("id").equals(id))return x.get("name");return id;}
%>
<%String pageName=(String)request.getAttribute("page");String csrf=h(session.getAttribute("csrf"));Map<String,String> identity=(Map<String,String>)request.getAttribute("identity");if(identity==null)identity=new HashMap<String,String>();String role=identity.getOrDefault("role","admin");boolean isAdmin="admin".equals(role);Map<String,String> settings=(Map<String,String>)request.getAttribute("settings");if(settings==null)settings=new HashMap<String,String>();String[] dayNames={"Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"};%>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CampusSchedule | Automated Timetable Generator</title><link rel="stylesheet" href="assets/app.css"></head><body>
<aside class="sidebar"><a class="brand" href="app"><span class="brand-mark">CS</span><span>CampusSchedule<small>TIMETABLE MANAGEMENT</small></span></a><p class="nav-label">WORKSPACE</p>
<%String[][] nav={{"dashboard","Overview"},{"generate","Generate timetable"},{"saved","Saved timetables"},{"departments","Departments"},{"faculty","Teachers"},{"classes","Classes"},{"classrooms","Rooms & labs"},{"subjects","Subjects"},{"reports","Workload & reports"},{"availability","Teacher availability"},{"settings","Days & period settings"},{"users","Login accounts"},{"activity","Activity history"},{"account","My account"},{"help","Demo guide"}};for(String[]n:nav){if(!isAdmin&&!Arrays.asList("dashboard","saved","account","help").contains(n[0]))continue;%><a class="nav <%=pageName.equals(n[0])?"active":""%>" href="app?page=<%=n[0]%>"><%=n[1]%></a><%}%>
<div class="sidebar-bottom"><span class="avatar">A</span><div><strong><%=h(session.getAttribute("user"))%></strong><small><%=h(role)%> workspace</small></div><form action="app" method="post"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="logout"><button class="logout" title="Sign out" aria-label="Sign out">↗</button></form></div></aside>
<div class="main"><header><div><span class="eyebrow">ACADEMIC PLANNING</span><h1><%String title="Overview";for(String[]n:nav)if(pageName.equals(n[0]))title=n[1];if(pageName.equals("timetable"))title="Weekly timetable";%><%=title%></h1></div><div class="header-right"><span class="pill"><%=h(settings.get("academic_year"))%> · <%=h(role)%></span><%if(isAdmin){%><a class="primary button" href="app?page=generate">+ Create timetable</a><%}else{%><a class="primary button" href="app?page=saved">My timetables</a><%}%></div></header><main class="content">
<%if(session.getAttribute("message")!=null){%><div role="alert" class="notice <%=Boolean.TRUE.equals(session.getAttribute("error"))?"error":"success"%>"><%=h(session.getAttribute("message"))%></div><%session.removeAttribute("message");session.removeAttribute("error");}%>
<%if(request.getAttribute("loadError")!=null){%><div class="notice error"><%=h(request.getAttribute("loadError"))%></div><%}else if(Arrays.asList("saved","timetable","reports","availability","settings","users","activity","account").contains(pageName)||(!isAdmin&&"dashboard".equals(pageName))){%><%@ include file="workspace.jsp" %><%}else if("dashboard".equals(pageName)){%>
<section class="quick-links"><a href="app?page=reports">Workload & reports ↗</a><a href="app?page=availability">Teacher availability ↗</a><a href="app?page=users">Login accounts ↗</a><a href="app?page=settings">Days & periods ↗</a></section><section class="hero"><div><span class="eyebrow">PLAN THE WEEK WITH CONFIDENCE</span><h2>A clear schedule.<br>Room for every class.</h2><p>Bring teachers, subjects and rooms together in one weekly timetable.</p><a class="button light" href="app?page=generate">Generate a timetable →</a></div><div class="hero-calendar"><div>WEEKLY PLANNER</div><div class="mini-grid"><%for(int i=0;i<25;i++){%><span class="cell c<%=i%4%>"></span><%}%></div><small>Class · Teacher · Room</small></div></section>
<section class="stats"><%String[][]stats={{"faculty","Teachers"},{"classes","Classes"},{"subjects","Subjects"},{"classrooms","Rooms & labs"},{"saved","Saved timetables"}};for(String[]s:stats){%><a class="stat" href="app?page=<%=s[0]%>"><span><%=s[1]%></span><strong><%=rows(request,s[0]).size()%></strong><small>View records ↗</small></a><%}%></section>
<div class="two-col"><section class="panel"><div class="panel-heading"><h2>Prepare your timetable</h2><span class="pill">3 steps</span></div><ol class="steps"><li><strong>Check your academic records</strong><p>Add classes, teachers, subjects and suitable rooms.</p></li><li><strong>Choose the teaching week</strong><p>Set working days and the number of teaching periods.</p></li><li><strong>Generate, review and print</strong><p>Open saved results anytime or download a CSV copy.</p></li></ol></section><section class="panel"><h2>Checks included</h2><ul class="checks"><li>No teacher in two classes at once</li><li>No room booked twice in one period</li><li>No overlapping lessons for a class</li><li>Room capacity and lab requirements</li><li>Weekly hours and teacher availability</li></ul><p class="muted">A result is saved only when every requested lesson is placed.</p></section></div>
<%}else if(AppServlet.FIELDS.containsKey(pageName)){String[]fields=AppServlet.FIELDS.get(pageName);Map<String,String> edit=(Map<String,String>)request.getAttribute("editRow");%>
<section class="panel"><div class="panel-heading"><div><h2><%=edit==null?"Add a record":"Edit record"%></h2><p class="muted">Changes are saved in the project database.</p></div><span class="pill"><%=rows(request,pageName).size()%> records</span></div><form method="post" action="app"><input type="hidden" name="action" value="save"><input type="hidden" name="entity" value="<%=pageName%>"><input type="hidden" name="id" value="<%=edit==null?"":h(edit.get("id"))%>"><input type="hidden" name="csrf" value="<%=csrf%>"><div class="form-grid">
<%for(String f:fields){String value=edit==null?"":edit.get(f);%><label><%=AppServlet.label(f)%>
<%if(f.endsWith("_id")){String target=f.equals("class_id")?"classes":f.equals("faculty_id")?"faculty":"departments";%><select name="<%=f%>" required><option value="">Select...</option><%for(Map<String,String>x:rows(request,target)){%><option value="<%=x.get("id")%>" <%=x.get("id").equals(value)?"selected":""%>><%=h(x.get("name"))%></option><%}%></select>
<%}else if(f.equals("type")){%><select name="type"><option <%= "Theory".equals(value)?"selected":""%>>Theory</option><option <%= "Lab".equals(value)?"selected":""%>>Lab</option></select>
<%}else if(f.equals("unavailable")){%><input name="unavailable" value="<%=h(value)%>" placeholder="e.g. 1:1,3:4"><small>Day:period, comma-separated. Monday = 1. Blank means available.</small>
<%}else if(f.equals("name")){%><input name="name" value="<%=h(value)%>" maxlength="80" required>
<%}else{%><input type="number" name="<%=f%>" value="<%=h(value)%>" min="1" max="<%=f.contains("hours")?48:500%>" required><%}%></label><%}%></div><div class="actions"><button class="primary"><%=edit==null?"Add record":"Save changes"%></button><%if(edit!=null){%><a class="button secondary" href="app?page=<%=pageName%>">Cancel edit</a><%}%></div></form></section>
<section class="panel"><div class="panel-heading"><h2>Current records</h2><input class="search" id="search" placeholder="Search records" aria-label="Search records"></div><div class="table-wrap"><table id="records"><thead><tr><%for(String f:fields){%><th><%=AppServlet.label(f)%></th><%}%><th>Actions</th></tr></thead><tbody><%for(Map<String,String>x:rows(request,pageName)){%><tr><%for(String f:fields){String value=x.get(f);if(f.endsWith("_id"))value=lookup(request,f.equals("class_id")?"classes":f.equals("faculty_id")?"faculty":"departments",value);%><td><%=h(value.isEmpty()?"—":value)%></td><%}%><td class="record-actions"><a href="app?page=<%=pageName%>&edit=<%=x.get("id")%>">Edit</a><form method="post" action="app" onsubmit="return confirm('Delete this record? Linked records must be removed first.');"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="delete"><input type="hidden" name="entity" value="<%=pageName%>"><input type="hidden" name="id" value="<%=x.get("id")%>"><button class="text-danger">Delete</button></form></td></tr><%}%></tbody></table></div><%if(rows(request,pageName).isEmpty()){%><p class="empty">No records yet. Add the first record above.</p><%}%></section>
<%}else if("generate".equals(pageName)){%>
<%List<Map<String,String>> generationClasses=rows(request,"generationClasses");
String selectedClass=generationClasses.isEmpty()?"":generationClasses.get(0).get("id");
String initialName=generationClasses.isEmpty()?"Weekly timetable":generationClasses.get(0).get("name")+" - Weekly timetable";
if(initialName.length()>80)initialName=initialName.substring(0,80);
int generationDays=Integer.parseInt(settings.get("days")),generationPeriods=Integer.parseInt(settings.get("periods"));
int initialHours=generationClasses.isEmpty()?0:Integer.parseInt(generationClasses.get(0).get("assigned"));
if(initialHours>0&&initialHours!=generationDays*generationPeriods){boolean found=false;for(int d=6;d>=1&&!found;d--)for(int p=8;p>=1;p--)if(d*p==initialHours){generationDays=d;generationPeriods=p;found=true;break;}}%>
<div class="two-col"><section class="panel"><span class="eyebrow">NEW WEEKLY SCHEDULE</span><h2>Set up the teaching week</h2>
<p class="muted">Choose the class whose subjects and activities you want to schedule.</p>
<form method="post" action="app" id="generate-form"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="generate">
<label>Class<select name="class_id" id="generation-class" required>
<%for(Map<String,String> group:generationClasses){%><option value="<%=h(group.get("id"))%>" data-hours="<%=h(group.get("assigned"))%>" <%=group.get("id").equals(selectedClass)?"selected":""%>><%=h(group.get("name"))%> — <%=h(group.get("assigned"))%> periods/week</option><%}%>
<option value="0">All classes together</option></select></label>
<label>Timetable name<input name="name" value="<%=h(initialName)%>" maxlength="80" required></label>
<div class="form-grid"><label>Working days<select name="days"><%for(int i=1;i<=6;i++){%><option value="<%=i%>" <%=i==generationDays?"selected":""%>><%=i%> days</option><%}%></select></label>
<label>Teaching periods per day<select name="periods"><%for(int i=1;i<=8;i++){%><option value="<%=i%>" <%=i==generationPeriods?"selected":""%>><%=i%> periods</option><%}%></select></label></div>
<label>Week coverage<select name="coverage"><option value="full" selected>Fill every period</option><option value="allow_free">Allow free periods</option></select></label>
<p class="notice" id="coverage-summary" aria-live="polite"><%=initialHours%> assigned periods · <%=generationDays*generationPeriods%> available slots</p>
<p class="muted">Fill every period requires each selected class's assigned periods to match the week. Add real subjects or activities if periods are missing. Period timings come from Days & period settings. Lab lessons use individual periods. New timetables are saved as drafts.</p>
<button class="primary full" id="generate-button">Generate & save timetable</button><p id="working" class="muted" hidden>Checking teacher, class and room availability…</p></form></section>
<section class="panel"><h2>Before you generate</h2><ul class="checks"><li>Choose your real class rather than an old demo class.</li><li>Assigned periods match the week when filling every period.</li><li>Teachers stay within their weekly limit.</li><li>A room has enough seats for each class.</li><li>Lab subjects have a suitable lab room.</li></ul><div class="notice">If a full week cannot be scheduled, the app explains the problem without saving an incomplete timetable.</div><a href="app?page=subjects">Review subjects →</a></section></div>
<script>
(()=>{const f=document.getElementById('generate-form'),choice=f.elements.class_id,days=f.elements.days,periods=f.elements.periods,coverage=f.elements.coverage,summary=document.getElementById('coverage-summary');
function describe(){const slots=Number(days.value)*Number(periods.value),option=choice.options[choice.selectedIndex];if(choice.value==='0'){summary.textContent=coverage.value==='full'?'Every class must have '+slots+' assigned periods.':'Each class can use up to '+slots+' periods.';return;}
const assigned=Number(option.dataset.hours),difference=slots-assigned;summary.textContent=assigned+' assigned periods · '+slots+' available slots. '+(difference===0?'Every period can be filled.':difference>0?(coverage.value==='full'?'Add '+difference+' subject or activity periods, or choose a smaller week.':difference+' periods will remain free.'):'Choose a larger week to fit all subjects.');}
choice.addEventListener('change',()=>{if(choice.value!=='0'){const total=Number(choice.options[choice.selectedIndex].dataset.hours);if(total!==Number(days.value)*Number(periods.value)){let found=false;for(let d=6;d>=1&&!found;d--)for(let p=8;p>=1;p--)if(d*p===total){days.value=String(d);periods.value=String(p);found=true;break;}}}describe();});
days.addEventListener('change',describe);periods.addEventListener('change',describe);coverage.addEventListener('change',describe);describe();})();
</script>
<%}else if("help".equals(pageName)){%><section class="panel guide"><span class="eyebrow">DEMONSTRATION GUIDE</span><h2>Show the complete project in five minutes</h2><ol class="steps"><li><strong>Introduce the problem</strong><p>Manual timetables need repeated checks for class, teacher and room conflicts.</p></li><li><strong>Show the database-backed records</strong><p>Open Teachers, Classes, Rooms and Subjects. Add or edit a record, then refresh the page to show that it is saved.</p></li><li><strong>Generate a timetable</strong><p>Select five days and six teaching periods. The Java scheduler places all requested lessons and saves the result.</p></li><li><strong>Explain a conflict check</strong><p>A teacher and a room can each be used only once in a period. The database also enforces unique slot bookings.</p></li><li><strong>Reopen and export</strong><p>Open Saved timetables, reopen the result, download CSV and use Print / Save PDF.</p></li><li><strong>Show an impossible case</strong><p>Try a one-day, one-period week. The application reports the problem without saving a partial timetable.</p></li></ol><h3>Project technologies</h3><p>Java 8, JSP, Servlets, JDBC, HTML, CSS and JavaScript. Demonstrated with Tomcat 9 and MariaDB, using a MySQL-compatible JDBC connection.</p><h3>New management options</h3><p>Use Workload & reports for database totals. Set blocked periods in Teacher availability. Set start time, working days and break length in Days & period settings. Open a saved draft to rename, duplicate or reschedule a lesson. Publish it to make it visible to teacher and student accounts. Login accounts manages linked users, password resets and access. Activity history records changes.</p><h3>Current limits</h3><p>Administrator, teacher and student roles. Teachers and students see only their own published schedules. Lab lessons occupy single periods. No consecutive multi-period lab rule or teacher preference optimisation. The bounded search stops after five seconds or 500,000 search nodes.</p><h3>Source acknowledgement</h3><p>Adapted from the supplied timetable scheduler backup, whose README credits Pranav Khurana. This submission replaces the older generation flow with database-driven constraint scheduling and adds persistence, validation and complete setup instructions.</p></section>
<%}else{%><section class="panel"><h2>Page not found</h2><a href="app">Return to overview</a></section><%}%>
<footer>Automated Timetable Generator · Advanced Java Programming · Nivash K & Gokul Prasath G</footer></main></div><script>const search=document.getElementById('search');if(search)search.addEventListener('input',()=>document.querySelectorAll('#records tbody tr').forEach(r=>r.hidden=!r.textContent.toLowerCase().includes(search.value.toLowerCase())));const roles=document.getElementById('role-choice');if(roles){const sync=()=>{document.getElementById('teacher-link').hidden=roles.value!=='teacher';document.getElementById('class-link').hidden=roles.value!=='student';document.querySelector('[name=faculty_id]').required=roles.value==='teacher';document.querySelector('[name=class_id]').required=roles.value==='student';};roles.addEventListener('change',sync);sync();}const form=document.getElementById('generate-form');if(form)form.addEventListener('submit',()=>{document.getElementById('generate-button').disabled=true;document.getElementById('working').hidden=false;});</script></body></html>
